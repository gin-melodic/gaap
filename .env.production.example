GAAP_API_IMAGE=ghcr.io/your-org/gaap-api:2026-08-14.1
GAAP_WEB_IMAGE=ghcr.io/your-org/gaap-web:2026-08-14.1

POSTGRES_DB=gaap
POSTGRES_USER=gaap
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
RABBITMQ_USER=gaap
RABBITMQ_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-at-least-32-random-characters
ALE_BOOTSTRAP_KEY=replace-with-exactly-64-hex-characters
TURNSTILE_SECRET=replace-with-cloudflare-turnstile-secret
BETA_ALLOWED_EMAILS=first@example.com,second@example.com

# Public browser configuration is embedded while building gaap-web. The ALE
# value must exactly match ALE_BOOTSTRAP_KEY above.
NEXT_PUBLIC_ALE_BOOTSTRAP_KEY=replace-with-the-same-64-hex-characters
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
