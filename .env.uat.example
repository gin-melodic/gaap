POSTGRES_DB=gaap_uat
POSTGRES_USER=gaap_uat
POSTGRES_PASSWORD=replace-with-a-local-uat-password
REDIS_PASSWORD=replace-with-a-local-uat-password
RABBITMQ_USER=gaap_uat
RABBITMQ_PASSWORD=replace-with-a-local-uat-password
JWT_SECRET=replace-with-at-least-32-random-characters
ALE_BOOTSTRAP_KEY=replace-with-exactly-64-hex-characters
BETA_ALLOWED_EMAILS=uat@gaap.local
NEXT_PUBLIC_ALE_BOOTSTRAP_KEY=replace-with-the-same-64-hex-characters
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Ops console (admin observation page). The path segment is random so the
# endpoint is not guessable; unset CONSOLE_ADMIN_EMAILS = everyone gets 403.
CONSOLE_PATH_CODE=replace-with-a-random-code
CONSOLE_ADMIN_EMAILS=admin@example.com
# Optional shared secret for server-to-server polling (X-Ops-Token header).
# CONSOLE_API_TOKEN=
# Frontend override (build time), must match CONSOLE_PATH_CODE:
# NEXT_PUBLIC_OPS_CODE=replace-with-a-random-code
